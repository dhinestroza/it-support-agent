---
import type { TicketAction } from "../lib/types";
import { AGENT_NAME, AGENT_ROLE, FIELD_LABELS, MESSAGES } from "../lib/labels";

interface Props {
  action: TicketAction | null;
  reasoning: string | null;
  draft: string | null;
}

const { action, reasoning, draft } = Astro.props;

const hasReasoning = reasoning !== null && reasoning.trim() !== "";
const hasDraft = draft !== null && draft.trim() !== "";

const words = AGENT_NAME.trim().split(/\s+/);
const initials = `${words[0]?.[0] ?? ""}${words.length > 1 ? (words.at(-1)?.[0] ?? "") : ""}`.toUpperCase();
---

{
  action === null ? (
    <p class="empty">
      <span lang="es">{MESSAGES.noDecision}</span>
    </p>
  ) : (
    <div class="message">
      <div class="avatar" aria-hidden="true">
        {initials}
      </div>
      <div class="body">
        <div class="who">
          <span class="name" lang="es">
            {AGENT_NAME}
          </span>
          <span class="role" lang="es">
            {AGENT_ROLE}
          </span>
        </div>
        {hasDraft && <div class="draft">{draft}</div>}
        {hasReasoning && (
          <p class="reasoning">
            <span class="reasoning-k" lang="es">
              {FIELD_LABELS.reasoning}:
            </span>{" "}
            {reasoning}
          </p>
        )}
      </div>
    </div>
  )
}

<style>
  .message {
    display: flex;
    gap: 0.75rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.3;
  }

  .name {
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .role {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .draft {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .reasoning {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .reasoning-k {
    font-weight: 600;
  }

  .empty {
    margin: 0;
    padding: 1rem 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>
