---
import type { TicketAction } from "../lib/types";
import { ACTION_LABELS, FIELD_LABELS, MESSAGES } from "../lib/labels";

interface Props {
  action: TicketAction | null;
  reasoning: string | null;
  draft: string | null;
}

const { action, reasoning, draft } = Astro.props;

const hasReasoning = reasoning !== null && reasoning.trim() !== "";
const hasDraft = draft !== null && draft.trim() !== "";
---

{
  action === null ? (
    <p class="empty">
      <span lang="es">{MESSAGES.noDecision}</span>
    </p>
  ) : (
    <section class="panel">
      <header class="head">
        <span lang="es" class="label">
          {FIELD_LABELS.proposedAction}
        </span>
        <strong lang="es" class="action">
          {ACTION_LABELS[action]}
        </strong>
      </header>
      {hasReasoning && (
        <div class="block">
          <h3 lang="es" class="field-label">
            {FIELD_LABELS.reasoning}
          </h3>
          <p class="reasoning">{reasoning}</p>
        </div>
      )}
      {hasDraft && (
        <div class="block">
          <h3 lang="es" class="field-label">
            {FIELD_LABELS.draft}
          </h3>
          <div class="draft">{draft}</div>
        </div>
      )}
    </section>
  )
}

<style>
  .panel,
  .empty {
    padding: 1rem 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .label,
  .field-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .label::after {
    content: ":";
  }

  .action {
    color: var(--color-brand);
    font-size: 0.95rem;
    text-transform: capitalize;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .reasoning {
    margin: 0;
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .draft {
    padding: 0.6rem 0.85rem;
    border-left: 2px solid var(--color-brand);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>
