---
import type { Source } from "../lib/types";

interface Props {
  source: Source;
}

const { source } = Astro.props;
---

<figure class="citation">
  <figcaption class="cap">
    <code class="doc-id">{source.doc_id}</code>
  </figcaption>
  <blockquote class="excerpt">{source.excerpt}</blockquote>
</figure>

<style>
  .citation {
    margin: 0;
    padding: 0.75rem 0.9rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-brand) 5%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cap {
    margin: 0;
  }

  .doc-id {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .excerpt {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
</style>
