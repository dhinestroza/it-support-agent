---
import StatusBadge from "./StatusBadge.astro";
import type { TicketSummary } from "../lib/types";
import { STATUS_LABELS, ACTION_LABELS, FIELD_LABELS } from "../lib/labels";
import { formatTicketDate } from "../lib/date";

interface Props {
  ticket: TicketSummary;
}

const { ticket } = Astro.props;

const created = formatTicketDate(ticket.created_at);

const cardLabel = `${ticket.subject}. ${FIELD_LABELS.status}: ${
  STATUS_LABELS[ticket.status]
}${
  ticket.action
    ? `. ${FIELD_LABELS.proposedAction}: ${ACTION_LABELS[ticket.action]}`
    : ""
}. ${created.label}`;
---

<a class="row" href={`/ticket?id=${ticket.ticket_id}`} aria-label={cardLabel}>
  <span class="top" aria-hidden="true">
    <span class="ticket-id">#{ticket.ticket_id.slice(0, 8)}</span>
    {
      created.iso ? (
        <time class="date" datetime={created.iso}>
          {created.label}
        </time>
      ) : (
        <span class="date">{created.label}</span>
      )
    }
  </span>
  <span class="subject" aria-hidden="true">{ticket.subject}</span>
  {
    ticket.body_excerpt && (
      <p class="excerpt" aria-hidden="true">
        {ticket.body_excerpt}
      </p>
    )
  }
  <span class="bottom" aria-hidden="true">
    <StatusBadge status={ticket.status} />
    {
      ticket.action && (
        <span class="action" lang="es">
          {FIELD_LABELS.proposedAction}: {ACTION_LABELS[ticket.action]}
        </span>
      )
    }
  </span>
</a>

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.15rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 120ms ease;
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row:hover {
    background: color-mix(in srgb, var(--color-brand) 5%, transparent);
  }

  .row:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .ticket-id {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    letter-spacing: 0.02em;
  }

  .subject {
    font-weight: 600;
    line-height: 1.35;
  }

  .excerpt {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bottom {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .action {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-brand) 10%, transparent);
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
  }
</style>
